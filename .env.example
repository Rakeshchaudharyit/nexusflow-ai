APP_NAME=nexusflow-api
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=false
API_V1_PREFIX=/api/v1
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexusflow
POSTGRES_USER=nexusflow
# Required: set a unique local password before starting Compose.
POSTGRES_PASSWORD=
# Optional overrides; leave empty to construct URLs from the fields above/below.
DATABASE_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=
CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000
# This is a browser URL, never a Docker service hostname.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional host port override if 8000 is already in use.
API_PORT=8000

# Required: generate with python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=nexusflow-api
JWT_AUDIENCE=nexusflow-web
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_COOKIE_NAME=nexusflow_refresh
# Production requires true and HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Agent runtime text generation. Only the offline "deterministic" provider exists in M3;
# no text-generation API key is required. Optional embedding keys are separate.
LLM_PROVIDER=deterministic

# MCP servers. Only exact host:port pairs listed here are reachable (JSON array). Compose
# defaults this to the internal demo service; for host development use ["localhost:8765"].
MCP_ALLOWED_HOSTS=["mcp-demo:8765"]
# Allow HTTPS servers on public addresses (DNS-checked). Leave false for local development.
MCP_ALLOW_PUBLIC_HOSTS=false
MCP_CONNECT_TIMEOUT_SECONDS=2
MCP_REQUEST_TIMEOUT_SECONDS=5
# Server-only address; Compose overrides this to the internal API hostname.
API_INTERNAL_URL=http://localhost:8000/api/v1

# M6 approval expiry, enforced on access/review (1–168 hours).
APPROVAL_EXPIRE_HOURS=24

# M7 background execution (docs/background-execution.md). The API persists runs and jobs in
# PostgreSQL and sends job ids through Redis to the worker service; "inline" is tests only.
EXECUTION_MODE=queue
QUEUE_NAME=nexusflow-runs
WORKER_HEARTBEAT_SECONDS=10
JOB_STALE_AFTER_SECONDS=60
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=5
JOB_RECOVERY_SECONDS=15
JOB_REDELIVER_AFTER_SECONDS=60

# M8 agent memory (docs/memory-context.md): bounded, tenant-scoped context injected into runs.
MEMORY_MAX_ENTRIES=20
MEMORY_MAX_CHARS=4000
MEMORY_SUMMARY_THRESHOLD=8
MEMORY_DEFAULT_TTL_DAYS=180

# M9 knowledge / RAG (docs/knowledge-rag.md). deterministic_local is offline and reproducible;
# production should use a real embedding model (openai: set OPENAI_API_KEY and
# KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small). The vector column is fixed at 384.
KNOWLEDGE_EMBEDDING_PROVIDER=deterministic_local
KNOWLEDGE_EMBEDDING_MODEL=nexusflow-hash-v1
KNOWLEDGE_EMBEDDING_DIMENSION=384
KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_CHUNK_OVERLAP=200
KNOWLEDGE_TOP_K=5
KNOWLEDGE_SEMANTIC_WEIGHT=0.7
KNOWLEDGE_LEXICAL_WEIGHT=0.3
KNOWLEDGE_MIN_SCORE=0.2
KNOWLEDGE_MAX_CONTEXT_CHARS=4000
KNOWLEDGE_MAX_FILE_MB=10
# Host development only; Compose mounts the knowledge_uploads volume at /data/knowledge.
KNOWLEDGE_UPLOAD_DIR=./.data/knowledge

# M11 security / deployment. APP_ENV (not ENV) selects validated production mode.
# Production: HTTPS origins, Secure cookies, generated JWT (48+ bytes), 16+ character
# database password, explicit Redis/MCP/upload settings. See docs/deployment.md.
ALLOWED_HOSTS=["localhost","127.0.0.1","api","testserver"]
# Optional embeddings provider key; never needed for deterministic demonstrations/tests.
OPENAI_API_KEY=
KNOWLEDGE_EMBEDDING_TIMEOUT_SECONDS=20
# Demo seed only: export these before make demo-seed. Existing users keep their password.
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=
